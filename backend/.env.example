# Copy this file to `backend/.env` and adjust the values.
# `.env` must never be committed: the root .gitignore covers it.
#
# The same file is read by two consumers:
#  - the `db` service in docker-compose.yml, which uses
#    POSTGRES_USER/PASSWORD/DB to initialize the database on first start;
#  - the NestJS backend, which uses all of them to connect.
# Changing user, password or database name after the first start has no effect
# on the existing volume: that requires `docker compose down -v`.

# Host and port the *backend* uses to reach the database.
# While the backend runs on the host, this is the localhost side of the port
# published by Docker; once it is a container too, it becomes the service name
# (`db`).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

POSTGRES_USER=cardue
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=cardue

# HTTP port of the NestJS backend.
PORT=3000

# --- Keycloak (ADR 0009) ---
# The backend is the confidential OIDC client: it exchanges the authorization
# code and keeps the tokens, so the browser only ever sees the session cookie.

# Where the realm lives. In production this becomes the public HTTPS address of
# the identity provider, because the browser is redirected to it too.
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/cardue

KEYCLOAK_CLIENT_ID=cardue-backend
# Generate one and keep it here only: `openssl rand -hex 32`. It is applied to
# the realm by keycloak/configure.sh, so it never has to be written anywhere
# that is versioned.
KEYCLOAK_CLIENT_SECRET=

# Origin the browser uses to reach the application: it is what the OIDC
# redirect comes back to, and it must be listed among the client's redirect
# URIs in the realm. 5173 with `npm run dev`, 4173 with `npm run preview`.
APP_BASE_URL=http://localhost:5173

# Application session (ADR 0009): 30 sliding days, renewed on every successful
# request. Longer means offline stays usable longer and a revoked session takes
# longer to bite.
SESSION_TTL_DAYS=30

# --- Google (opzionale, ADR 0009) ---
# Left empty: without them the deploy still works, with email and password
# only. Filling them in makes `keycloak/configure.sh` connect Google as an
# identity provider at the next `docker compose up`.
#
# They come from the Google Cloud Console, where the authorized redirect URI
# must be the *broker* endpoint of the realm, not the application:
#   http://localhost:8080/realms/cardue/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Utente di sviluppo (solo in locale) ---
# Filling this in makes keycloak/configure.sh create an account to sign in with
# while developing. Leave it **empty everywhere else**: an unset password means
# the account is never created, which is why it is not in the realm file.
CARDUE_DEV_USER_PASSWORD=
CARDUE_DEV_USER_NAME=andrea
CARDUE_DEV_USER_EMAIL=andrea.rossi@example.com
CARDUE_DEV_USER_FIRST_NAME=
CARDUE_DEV_USER_LAST_NAME=
