# Modello del `backend/.env` **del server** (ADR 0012).
#
# Non sostituisce `.env.example`: quello descrive la macchina di sviluppo, dove
# backend e frontend girano sull'host. Qui tutto sta in container, e cambiano
# tre cose — l'host del database, gli indirizzi pubblici, e il fatto che di
# segreti veri ce ne sono.
#
# Sul server:
#   cp backend/.env.deploy.example backend/.env
# e poi riempilo. Non viene committato: il .gitignore di root lo copre.

# --- Database ---
# `db` e non `localhost`: il backend è un container e il database è un altro,
# raggiungibile per nome sulla rete di compose. Per la stessa ragione la porta è
# quella interna, 5432, non quella pubblicata sull'host — che sul server non
# viene pubblicata affatto.
POSTGRES_HOST=db
POSTGRES_PORT=5432

POSTGRES_USER=cardue
# Nessun default: `openssl rand -hex 24`. Va scelta *prima* del primo avvio —
# cambiarla dopo non ha effetto sul volume già inizializzato.
POSTGRES_PASSWORD=
POSTGRES_DB=cardue

PORT=3000

# --- Keycloak (ADR 0009) ---
# Sostituisci l'host con il PUBLIC_HOSTNAME che hai messo nel `.env` di root.
# Il prefisso /idp non è decorativo: è KC_HTTP_RELATIVE_PATH, ed è ciò che
# tiene l'identity provider fuori dalla radice, dove abitano le rotte dell'app.
KEYCLOAK_ISSUER_URL=https://cardue-dev.tuo-tailnet.ts.net/idp/realms/cardue

KEYCLOAK_CLIENT_ID=cardue-backend
# `openssl rand -hex 32`. keycloak/configure.sh lo applica al realm a ogni
# avvio: cambiarlo qui e rifare il deploy è sufficiente a ruotarlo.
KEYCLOAK_CLIENT_SECRET=

# L'origine da cui il browser vede l'applicazione. Determina i redirect URI del
# client OIDC, quindi deve essere esatta: uno slash finale di troppo e il
# ritorno dal login fallisce.
APP_BASE_URL=https://cardue-dev.tuo-tailnet.ts.net

SESSION_TTL_DAYS=30

# --- Google (opzionale) ---
# Le stesse due variabili stanno anche nel `.env` di root, che è quello da cui
# le legge il servizio keycloak-config.
# Il redirect URI autorizzato nella Google Cloud Console è l'endpoint *broker*
# del realm:
#   https://cardue-dev.tuo-tailnet.ts.net/idp/realms/cardue/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Utente di sviluppo ---
# Qui, a differenza di una produzione, ha senso tenerlo: questo *è* l'ambiente
# di sviluppo, e l'alternativa è creare l'account a mano nella console a ogni
# ricostruzione della macchina. Con la password vuota l'account non nasce.
CARDUE_DEV_USER_PASSWORD=
CARDUE_DEV_USER_NAME=andrea
CARDUE_DEV_USER_EMAIL=andrea.rossi@example.com
CARDUE_DEV_USER_FIRST_NAME=
CARDUE_DEV_USER_LAST_NAME=
